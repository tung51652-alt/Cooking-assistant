# Development defaults fixed by Phase 0. Release files will pin image digests.
# No Docker Hub account or credentials are assumed here.
HOST_PORT=8080
VISION_BASE_URL=http://vision:8000
RECIPES_BASE_URL=http://recipes:8000
QDRANT_URL=http://qdrant:6333
FOOD_MODEL_PATH=/opt/cooklens/models/efficientnet_b2_best.pt
EMBEDDING_MODEL_PATH=/opt/cooklens/models/multilingual-e5-small
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
MAX_UPLOAD_BYTES=10485760
UPSTREAM_CONNECT_TIMEOUT_SECONDS=2
VISION_READ_TIMEOUT_SECONDS=15
RECIPES_READ_TIMEOUT_SECONDS=5
