# Optional Compose settings. Defaults work without this file.
# rc.1 images are built locally in Phase 5, not published application v2.0.0.
COOKLENS_IMAGE_PREFIX=cooklens
COOKLENS_IMAGE_TAG=2.0.0-rc.1
HOST_PORT=8080
VISION_BASE_URL=http://vision:8000
RECIPES_BASE_URL=http://recipes:8001
QDRANT_URL=http://qdrant:6333
FOOD_MODEL_PATH=/opt/cooklens/models/efficientnet_b2_best.pt
EMBEDDING_MODEL_PATH=/opt/cooklens/models/multilingual-e5-small
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
MAX_UPLOAD_BYTES=10485760
UPSTREAM_CONNECT_TIMEOUT_SECONDS=2
VISION_READ_TIMEOUT_SECONDS=15
RECIPES_READ_TIMEOUT_SECONDS=5
