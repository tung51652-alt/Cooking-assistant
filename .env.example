# Optional. docker compose up works without an .env file.
HOST_PORT=8080
HOST_BIND=127.0.0.1
# For Expo Go on your private LAN, set HOST_BIND to the Docker host LAN IP.

# Optional LLM assistant configuration (prepares for Phase 10+):
# - Docker Compose works without these variables.
# - Compose forwards LLM_* only to backend and gives backend a dedicated egress bridge.
# - Published 2.0.0-rc.2 images do not contain the assistant; build source images first.
# - Keep LLM_API_KEY blank here; supply real keys only via untracked .env or
#   runtime environment variables (never commit keys to Git, docs, or images).
# - Default below targets NVIDIA Nemotron 3 Ultra (free tier, OpenAI-compatible).
# - Model/endpoint checked against https://build.nvidia.com/nvidia/nemotron-3-ultra-550b-a55b
# - Only the OpenAI-compatible adapter is implemented. Other providers return
#   ASSISTANT_PROVIDER_UNSUPPORTED; no silent fallback or unverified model aliases.
# - Pricing permits only the curated NVIDIA trial models listed in backend/README.md.
#   Other endpoints/models need a verified billing policy before HTTP chat can use them.
LLM_PROVIDER=openai
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=512
# Admission estimate, not an exact tokenizer or billing count.
LLM_MAX_INPUT_TOKENS=6000
